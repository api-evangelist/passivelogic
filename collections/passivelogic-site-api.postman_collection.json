        {
          "id": "45c5e6f7-ef5c-4468-9853-06ba6bac694a",
          "name": "Copy Project from one organization to another",
          "request": {
            "name": "Copy Project from one organization to another",
            "description": {
              "content": "Copies Project from one organization to a target organization given a project Identifier.\nAll UUID's are created new for the copied project.\nReturns a mapping of old identifiers and new identifiers of the given project.\nHistory data is NOT copied unless startDate and endDate are provided.\nHistory copy will take time to complete in the background and there will be no indication of success.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v0.20",
                "site",
                "copy"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "targetOrganizationID",
                  "value": "<uuid>",
                  "description": "(Required) Organization to copy the given site into."
                },
                {
                  "disabled": false,
                  "key": "siteID",
                  "value": "<uuid>",
                  "description": "(Required) Site to copy."
                },
                {
                  "disabled": false,
                  "key": "siteName",
                  "value": "<string,null>",
                  "description": "Optionally change the copied site name."
                },
                {
                  "disabled": false,
                  "key": "siteDirectory",
                  "value": "<string,null>",
                  "description": "Optionally change the copied site directory."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<string,null>",
                  "description": "Date to start copying history from. Required to export all history."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<string,null>",
                  "description": "Date to end copying history at. Required to export all history."
                }
              ],
              "variable": []
            },
            "header": [
              {
