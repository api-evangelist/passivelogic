        {
          "id": "a0bbf7f2-22cb-4bdf-8376-53e4f175a480",
          "name": "Uploads an image.",
          "request": {
            "name": "Uploads an image.",
            "description": {
              "content": "Uploads an image to the server, setting its new stored url & checksum in the database. If an existing ID is given, this will\nattempt an update of the image data. The data may be sent in either multipart/form-data or JSON format. If using JSON, the\nimage file must be Base64-encoded. Using multipart/form-data is recommended as it is a more efficient way to transmit binary\ndata.\n\nThis endpoint is intended for associating image file data with an existing `Image` node in the Quantum schema.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v0.20",
                "image"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "ID",
                  "value": "<uuid>",
                  "type": "text",
                  "description": "(Required) UUID of the quantum image node that you want to associate this image file with."
                },
                {
                  "key": "fileType",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The type of file the given data represents, from a list of allowed files."
                },
                {
                  "key": "image",
                  "value": "<byte>",
                  "type": "text",
                  "description": "(Required) File data to write to the server. Must be Base64-encoded if sending as JSON."
                },
                {
                  "key": "filePath",
                  "value": "<string,null>",
                  "type": "text",
                  "description": ""
                }
              ]
            }
          },
          "response": [
