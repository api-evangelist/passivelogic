          "name": "Uploads a file associated with a binding.",
          "request": {
            "name": "Uploads a file associated with a binding.",
            "description": {
              "content": "Uploads a file to the server and associates that file with a binding node, setting its new stored URL & checksum in the\ndatabase. The data may be sent in either multipart/form-data or JSON format. If using JSON, the image file must be\nBase64-encoded. Using multipart/form-data is recommended as it is a more efficient way to transmit binary data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v0.20",
                "binding"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "ID",
                  "value": "<uuid>",
                  "type": "text",
                  "description": "(Required) UUID of the quantum binding node that you want to associate this file with."
